# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── RAG data & generated outputs ─────────────────────────────────────────────
# data/ and chroma_db/_manifest.json ARE tracked — needed so a fresh deploy
# skips re-embedding (Qdrant Cloud already has the vectors; manifest hash
# match short-circuits needs_indexing()).
RAG/chroma_db/*
!RAG/chroma_db/_manifest.json
RAG/comparison.json
RAG/results.json
RAG/eval_results_*.json
RAG/dashboard-*.html
RAG/dashboard_*.html
RAG/tmp_*.py

# ── Next.js / Node ────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
frontend/.env
frontend/.env.local

# ── Misc ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
