# Copy this to .env and fill in your keys — never commit .env itself

OPENAI_API_KEY=sk-...
FANAR_API_KEY=...

QDRANT_URL=https://your-cluster.us-east-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=...

# Origins allowed to call the FastAPI backend (comma-separated)
# Set this to your deployed frontend URL in production
ALLOWED_ORIGINS=http://localhost:3000

# Optional: LLM response timeout in seconds (default 30)
LLM_TIMEOUT_SECONDS=30

# ── Environment / release ────────────────────────────────────────────────────
# "development" (default) or "production" — production fails fast on missing config
ENVIRONMENT=development
APP_VERSION=0.1.0-dev

# Log level: DEBUG | INFO (default) | WARNING | ERROR
LOG_LEVEL=INFO

# ── Observability (all optional — features activate when set) ────────────────
# Sentry error tracking: create a project at sentry.io, paste its DSN here.
# sentry-sdk is already a dependency; setting this is the ONLY step needed.
# SENTRY_DSN=

# Langfuse LLM tracing: create a project at cloud.langfuse.com, paste its
# keys below. langfuse is already a dependency — setting these is the only
# step needed. Traces wrap every chat completion automatically.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Prometheus needs no configuration — metrics are always exposed at /metrics
# (blocked from external access by nginx in production; see OBSERVABILITY.md).

# ── Hybrid retrieval (all optional — on by default) ──────────────────────────
# BM25 keyword search fused with the existing vector search via Reciprocal
# Rank Fusion. Set to "false" to fall back to vector-only retrieval.
# ENABLE_HYBRID_RETRIEVAL=true

# Cross-encoder reranking pass over the fused candidates. Downloads a ~470MB
# multilingual model on first use (cached after) — set to "false" to skip it
# and keep BM25+vector fusion without the rerank step.
# ENABLE_RERANKER=true
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
